{%- set des_label = "max_des_" ~ des_idx -%}
{%- macro des_in_label_x(x) -%}
	{{ des_label ~ "_in_" ~ x }}
{%- endmacro %}
{%- macro des_i2c_label_x(x) -%}
	{{ des_label ~ "_i2c_" ~ x }}
{%- endmacro %}

&i2c_bus {
	{{des_label}}: gmsl-deserializer@27 {
		#address-cells = <1>;
		#size-cells = <0>;

		compatible = "maxim,max96724";
		reg = <0x27>;
	};
};

&{{des_label}} {
	i2c-alias-pool = <0x40 0x41 0x42 0x43>;

	i2c-atr {
		#address-cells = <1>;
		#size-cells = <0>;
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

{%- for ser_cfg in des_cfg.links -%}
	{%- set ser_idx = loop.index0 -%}
	{%- include '%s.dtsi.in' % ser_cfg.name -%}
{%- endfor -%}
